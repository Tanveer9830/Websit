# ─────────────────────────────────────────────────────────────────────────────
# Top Cloud — environment template
# Copy to .env (the one-command installer does this for you) and never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# SQLite (libSQL) database. The installer writes an absolute path so scripts
# and the Next.js runtime always open the exact same file.
DATABASE_URL="file:./data/topcloud.db"

# Public URL of the panel (no trailing slash). Used for verification/reset links.
APP_URL="http://localhost:3000"

# Set to "true" only when the panel is served over HTTPS. Leave "false" for local
# HTTP development; the installer enables a Secure-by-default cookie on HTTPS.
COOKIE_SECURE="false"

# Session lifetime in days (1–30).
SESSION_TTL_DAYS="7"

# First-run owner bootstrap (used only once, when NO owner exists).
# The defaults required by the specification are admin / admin.
# Optionally override the initial password at first initialization; it is then
# stored only as an Argon2id hash and must be changed on first login.
OWNER_USERNAME="admin"
OWNER_INITIAL_PASSWORD="admin"
OWNER_EMAIL="owner@topcloud.local"

# ── Email (optional) ─────────────────────────────────────────────────────────
# Without SMTP, verification and password-reset emails cannot be delivered.
# The panel still works (email verification is optional by default); configure
# SMTP for real delivery. For LOCAL DEVELOPMENT ONLY you may set
# DEV_EMAIL_TOKENS="true" to print one-time links to the server log. Never
# enable that flag on a public server.
DEV_EMAIL_TOKENS="false"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Top Cloud <no-reply@topcloud.local>"
